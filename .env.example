# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# HMK_HQ_PASSCODE: Optional server-side Fleet HQ administrator passcode.
# Leave unset during first-run setup to claim the initial Fleet HQ Admin via UI.
HMK_HQ_PASSCODE=

# SESSION_SECRET: Optional HMAC signing key for Bearer session tokens.
SESSION_SECRET=
